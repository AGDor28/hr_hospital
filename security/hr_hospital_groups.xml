<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="category_hr_hospital" model="ir.module.category">
            <field name="name">Hospital Management</field>
            <field name="description">User access levels for the Hospital</field>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_hr_hospital" model="res.groups.privilege">
            <field name="name">Hospital</field>
            <field name="sequence">9</field>
            <field name="category_id" ref="hr_hospital.category_hr_hospital"/>
        </record>

        <record id="group_hospital_patient" model="res.groups">
            <field name="name">Patient</field>
            <field name="privilege_id" ref="privilege_hr_hospital"/>
        </record>

        <record id="group_hospital_intern" model="res.groups">
            <field name="name">Intern</field>
            <field name="privilege_id" ref="privilege_hr_hospital"/>
            <field name="implied_ids" eval="[(4, ref('group_hospital_patient'))]"/>
        </record>

        <record id="group_hospital_doctor" model="res.groups">
            <field name="name">Doctor</field>
            <field name="privilege_id" ref="privilege_hr_hospital"/>
            <field name="implied_ids" eval="[(4, ref('group_hospital_intern'))]"/>
        </record>

        <record id="group_hospital_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_hr_hospital"/>
            <field name="implied_ids" eval="[(4, ref('group_hospital_doctor'))]"/>
        </record>

        <record id="group_hospital_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_hr_hospital"/>
            <field name="implied_ids" eval="[(4, ref('group_hospital_manager'))]"/>
            <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>