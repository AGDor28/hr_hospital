<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="rule_hospital_visit_patient" model="ir.rule">
            <field name="name">Patient: Own Visits Only</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="groups" eval="[(4, ref('group_hospital_patient'))]"/>
            <field name="domain_force">[('patient_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hospital_visit_intern" model="ir.rule">
            <field name="name">Intern: Own Visits Only</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="groups" eval="[(4, ref('group_hospital_intern'))]"/>
            <field name="domain_force">[('doctor_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hospital_visit_doctor" model="ir.rule">
            <field name="name">Doctor: Own and Interns Visits</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="groups" eval="[(4, ref('group_hospital_doctor'))]"/>
            <field name="domain_force">['|', ('doctor_id.user_id', '=', user.id), ('doctor_id.mentor_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hospital_visit_manager" model="ir.rule">
            <field name="name">Manager: See All Visits</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="groups" eval="[(4, ref('group_hospital_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>